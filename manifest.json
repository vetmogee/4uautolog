{
  "manifest_version": 3,
  "name": "Plus4U Auto Login (Unicorn University)",
  "version": "1.2.0",
  "description": "Checks whether you are signed in to the Plus4U portal (and unicornuniversity.net/cs/uis) and, if not, signs you in with the login method you used last.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.plus4u.net/*", "https://unicornuniversity.net/*", "https://*.unicornuniversity.net/*", "https://accounts.google.com/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.plus4u.net/*", "https://unicornuniversity.net/*", "https://*.unicornuniversity.net/*"],
      "js": ["src/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.plus4u.net/*", "https://unicornuniversity.net/*", "https://*.unicornuniversity.net/*"],
      "js": ["src/shared.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://accounts.google.com/*"],
      "js": ["src/shared.js", "src/google.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Plus4U Auto Login",
    "default_popup": "popup/popup.html"
  }
}
